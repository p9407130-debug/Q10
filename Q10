#include <stdio.h>
int main(){
    int t,h,m,s;
    printf("enter the value of time(sec): ");
    scanf("%d",&t);
    h = t/3600;
    m = (t%3600)/60;
    s = t%60;
    printf("time in hour , minute , second is %2d:%2d:%2d",h,m,s);
    return 0 ;
}

